local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local speed = 100
local spinning = false
local antiFling = true
local angle = 0

local gui = Instance.new("ScreenGui")
gui.Name = "NanahhbFling"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(245, 205)
frame.Position = UDim2.new(0.5,-122,0.5,-102)
frame.BackgroundColor3 = Color3.fromRGB(255,220,235)
frame.Parent = gui

Instance.new("UICorner",frame).CornerRadius = UDim.new(0,15)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,40)
title.BackgroundTransparency = 1
title.Text = "🎀 Nanahhb Fling"
title.TextColor3 = Color3.fromRGB(180,65,120)
title.Font = Enum.Font.GothamBold
title.TextSize = 19
title.Parent = frame

local function makeButton(text,y)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0.85,0,0,35)
    b.Position = UDim2.new(0.075,0,0,y)
    b.BackgroundColor3 = Color3.fromRGB(255,177,204)
    b.Text = text
    b.TextColor3 = Color3.fromRGB(120,50,85)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 14
    b.Parent = frame
    Instance.new("UICorner",b).CornerRadius = UDim.new(0,9)
    return b
end

local fling = makeButton("Fling: OFF",48)

local input = Instance.new("TextBox")
input.Size = UDim2.new(0.85,0,0,32)
input.Position = UDim2.new(0.075,0,0,90)
input.BackgroundColor3 = Color3.fromRGB(255,248,252)
input.Text = "100"
input.TextColor3 = Color3.fromRGB(120,50,85)
input.Font = Enum.Font.GothamBold
input.TextSize = 14
input.Parent = frame
Instance.new("UICorner",input).CornerRadius = UDim.new(0,8)

local anti = makeButton("Anti-Fling: ON",132)

fling.Activated:Connect(function()
    spinning = not spinning
    fling.Text = spinning and "Fling: ON" or "Fling: OFF"
end)

input.FocusLost:Connect(function()
    local n = tonumber(input.Text)
    if n and n >= 0 then
        speed = math.min(n,10000000)
    end
    input.Text = tostring(speed)
end)

anti.Activated:Connect(function()
    antiFling = not antiFling
    anti.Text = antiFling and "Anti-Fling: ON" or "Anti-Fling: OFF"
end)

RunService.RenderStepped:Connect(function(dt)
    if not spinning then return end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    angle = (angle + math.rad(speed)*dt) % (math.pi*2)
    root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0,angle,0)
end)

-- Drag menu
local dragging = false
local dragStart, startPos

frame.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch
    or i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = i.Position
        startPos = frame.Position
    end
end)

UIS.InputChanged:Connect(function(i)
    if dragging and (
        i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseMovement
    ) then
        local d = i.Position-dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale,startPos.X.Offset+d.X,
            startPos.Y.Scale,startPos.Y.Offset+d.Y
        )
    end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch
    or i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
